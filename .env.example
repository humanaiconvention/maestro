# === Required ===
# !! PRODUCTION: rotate all three secrets before each deployment !!
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Copy .env.production.example → .env.production and fill in fresh values.
# NEVER reuse dev secrets in production.
CAPTCHA_HMAC_KEY=          # HMAC-SHA256 key for Altcha PoW challenges
MAESTRO_JWT_SECRET=        # Signs anonymous session JWTs
SESSION_SECRET=            # Web UI session cookie signing

# === CORS ===
# PRODUCTION: set to your prod domain — never use * in production.
# Example: MAESTRO_CORS_ORIGINS=https://humanaiconvention.com
MAESTRO_CORS_ORIGINS=http://localhost:5173  # Comma-separated allowed origins

# === Model/Adapter ===
USE_MOCK_ADAPTER=false     # true = mock responses (dev only)
USE_LOCAL_ADAPTER=false    # true = local Qwen model
ANTHROPIC_API_KEY=         # Required if USE_MOCK_ADAPTER=false and USE_LOCAL_ADAPTER=false

# === Database ===
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maestro

# === Export ===
EXPORT_API_KEY=            # Bearer key for GET /v1/export/kernels (admin only)

# === Optional ===
MAESTRO_LAUNCH_MODE=public_readonly  # test | public_readonly
RATE_LIMIT_RPM=60          # Requests per minute per key
SESSION_EXPIRY_SECONDS=7200
CAPTCHA_MAX_NUMBER=100000
CAPTCHA_EXPIRY_SECONDS=600
