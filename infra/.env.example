# ==========================================
# Project Maestro - Environment Variables
# ==========================================

# --- Database ---
# Password for the infrastructure PostgreSQL container
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Password for the infrastructure Redis container
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# PostgreSQL user for identity service
PG_USER=maestro
# PostgreSQL password for identity service
PG_PASS=CHANGE_ME_STRONG_PASSWORD
# PostgreSQL host for identity service
PG_HOST=localhost
# PostgreSQL port for identity service
PG_PORT=5432
# PostgreSQL database name for identity service
PG_DB=maestro_auth
# Full SQLAlchemy database URL for the main application (legacy MVP)
DATABASE_URL=postgresql://maestro:CHANGE_ME_STRONG_PASSWORD@localhost:5432/maestro

# --- Auth & Security ---
# Secret key for JWT signing and verification
MAESTRO_JWT_SECRET=CHANGE_ME_STRONG_SECRET
# Secret key for web UI session cookies
SESSION_SECRET=CHANGE_ME_STRONG_SECRET
# Root token for the infrastructure Hashicorp Vault container
VAULT_DEV_ROOT_TOKEN_ID=CHANGE_ME_STRONG_ROOT_TOKEN
# URL for the Ory Hydra administrative API
HYDRA_ADMIN_URL=http://localhost:4445
# URL for the Authentik identity provider
AUTHENTIK_URL=http://localhost:9000

# --- Gateway & Adapters ---
# Toggle between 'true' (mock responses) and 'false' (real LLM calls)
USE_MOCK_ADAPTER=true
# API Key for Anthropic Claude models (required if USE_MOCK_ADAPTER=false)
ANTHROPIC_API_KEY=CHANGE_ME_SK_ANT_...

# --- System Settings ---
# Enable test database and mock behaviors (true/false)
TESTING=false
