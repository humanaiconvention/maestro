# Model paths for local inference
# Download QWEN model weights and set the path here
# Example: /path/to/Qwen/Qwen-7B-Chat
QWEN_MODEL_PATH=

# Download LLAMA model weights and set the path here  
# Example: /path/to/llama-2-7b-chat-hf
LLAMA_MODEL_PATH=

# Optional: QWEN API key (if using API instead of local weights)
# QWEN_API_KEY=your-api-key-here
